# Kazuo : configuration du serveur.
# À copier dans /etc/kazuo/kazuo.env (droits 640, groupe kazuo), puis à remplir SUR LE SERVEUR.
# Ce fichier d'exemple ne contient aucun secret ; le vrai fichier ne doit jamais être commité.

KAZUO_DATA_DIR=/var/lib/kazuo
KAZUO_TZ=Europe/Paris

# Ollama (peut tourner sur une autre machine du réseau local)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=gpt-oss:20b

# Adzuna : https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# France Travail (API « Offres d'emploi », accès sur demande)
FT_CLIENT_ID=
FT_CLIENT_SECRET=

# Boîte e-mail dédiée : mot de passe d'APPLICATION, jamais celui du compte
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
