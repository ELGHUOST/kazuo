[Unit]
Description=Kazuo - recherche d'emploi assistée par IA
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=kazuo
Group=kazuo
WorkingDirectory=/opt/kazuo
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/kazuo/.venv/bin/uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --no-server-header
Restart=on-failure
RestartSec=5

# Durcissement : l'appli ne voit et ne modifie que ce dont elle a besoin
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/kazuo
RestrictSUIDSGID=yes
UMask=0027

[Install]
WantedBy=multi-user.target
