[Unit]
Description=Kazuo - recherche d'emploi assistée par IA
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=kazuo
Group=kazuo
WorkingDirectory=/opt/kazuo
Environment=PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1
# 127.0.0.1 : seul Tailscale Serve (sur cette même machine) peut joindre Kazuo
ExecStart=/opt/kazuo/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 1 --no-server-header
Restart=on-failure
RestartSec=5
UMask=0027

# --- Fichiers : tout en lecture seule, sauf les données ---
ProtectSystem=strict
ReadWritePaths=/var/lib/kazuo
ProtectHome=yes
PrivateTmp=yes

# --- Privilèges : aucun, et impossible d'en obtenir ---
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
RestrictSUIDSGID=yes
RemoveIPC=yes

# --- Noyau : ni réglages, ni modules, ni journaux, ni cgroups, ni nom d'hôte ---
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectHostname=yes

# --- Appels système et réseau : uniquement ce dont un service web a besoin ---
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources
SystemCallErrorNumber=EPERM
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes

[Install]
WantedBy=multi-user.target
